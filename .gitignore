# Build output. Regenerated by `dotnet build`, so tracking it only ever produces conflicts.
[Bb]in/
[Oo]bj/

# Local publish output
[Pp]ublish/
*.publishsettings

# User-specific IDE and tooling state
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# Secrets and machine-specific configuration. appsettings.json is tracked on purpose because it
# holds development defaults only; anything real belongs in user-secrets or the environment.
appsettings.*.local.json
*.env
.env
!frontend/.env.example

# Test and diagnostic output
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.log

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
